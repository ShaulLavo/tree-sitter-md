{
  "name": "tree-sitter-md",
  "version": "0.1.0",
  "description": "Markdown for editors: a tree-sitter block grammar for web-tree-sitter and a CommonMark + GFM inline resolver in wasm",
  "type": "module",
  "main": "./js/index.js",
  "types": "./js/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./tree-sitter-md.wasm": "./tree-sitter-md.wasm",
    "./tree-sitter-markdown.wasm": "./tree-sitter-markdown.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "tree-sitter-md.wasm",
    "tree-sitter-markdown.wasm",
    "LICENSE",
    "NOTICE.md",
    "licenses/"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/tree-sitter-md.git"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "tree-sitter",
    "wasm",
    "editor"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "generate": "cd grammar && tree-sitter generate",
    "spec": "cd bench && node spec.mjs",
    "corpus": "cd bench && node corpus.mjs",
    "bench": "cd bench && node keystroke.mjs",
    "test": "node --test tests/*.mjs"
  },
  "peerDependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "0.26.13",
    "web-tree-sitter": "0.27.0"
  }
}
