{
  "name": "tree-sitter-md",
  "version": "0.1.16",
  "description": "Markdown for editors: a tree-sitter block grammar and a CommonMark + GFM inline resolver that runs inside tree-sitter-x",
  "type": "module",
  "main": "./js/index.js",
  "types": "./js/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./tree-sitter-md.wasm": "./tree-sitter-md.wasm",
    "./tree-sitter-markdown-chat.wasm": "./tree-sitter-markdown-chat.wasm",
    "./tree-sitter-markdown.wasm": "./tree-sitter-markdown.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "js/constants.js",
    "js/constants.d.ts",
    "js/semantic.js",
    "js/semantic.d.ts",
    "tree-sitter-md.wasm",
    "tree-sitter-markdown.wasm",
    "tree-sitter-markdown-chat.wasm",
    "LICENSE",
    "NOTICE.md",
    "licenses/"
  ],
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/tree-sitter-md.git"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "tree-sitter",
    "wasm",
    "editor"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "generate": "cd grammar && tree-sitter generate && cd chat && tree-sitter generate",
    "spec": "cd bench && node spec.mjs",
    "corpus": "cd bench && node corpus.mjs",
    "bench": "cd bench && node keystroke.mjs",
    "test": "node --test tests/*.mjs tests/*.test.ts",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext tests/types/presentation.ts",
    "streaming:check": "node scripts/check-streaming.mjs",
    "streaming:qualification": "node scripts/check-streaming-qualification.mjs",
    "bench:presentation": "node bench/presentation.mjs",
    "check": "node scripts/check-gates.mjs",
    "test:browser": "node scripts/check-semantics-browser.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:native": "sh scripts/check-native.sh"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#aab7db1518c19f61c1b13ec3f832b881cf5f1385"
  },
  "peerDependencies": {
    "web-tree-sitter": "^0.28.1"
  },
  "overrides": {
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#aab7db1518c19f61c1b13ec3f832b881cf5f1385"
  }
}
