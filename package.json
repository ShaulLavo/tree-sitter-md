{
  "name": "tree-sitter-md",
  "version": "0.1.2",
  "description": "Markdown for editors: a tree-sitter block grammar and a CommonMark + GFM inline resolver that runs inside tree-sitter-x",
  "type": "module",
  "main": "./js/index.js",
  "types": "./js/index.d.ts",
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./tree-sitter-md.wasm": "./tree-sitter-md.wasm",
    "./tree-sitter-markdown.wasm": "./tree-sitter-markdown.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "js/constants.js",
    "js/constants.d.ts",
    "tree-sitter-md.wasm",
    "tree-sitter-markdown.wasm",
    "LICENSE",
    "NOTICE.md",
    "licenses/"
  ],
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/tree-sitter-md.git"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "tree-sitter",
    "wasm",
    "editor"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "generate": "cd grammar && tree-sitter generate",
    "spec": "cd bench && node spec.mjs",
    "corpus": "cd bench && node corpus.mjs",
    "bench": "cd bench && node keystroke.mjs",
    "test": "node --test tests/*.mjs",
    "check": "node scripts/check-gates.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:native": "sh scripts/check-native.sh"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "vite": "8.3.1",
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#059451d3c167443643630d471c2c2d61c13b10ff"
  },
  "peerDependencies": {
    "web-tree-sitter": "github:ShaulLavo/tree-sitter-x#059451d3c167443643630d471c2c2d61c13b10ff"
  }
}
