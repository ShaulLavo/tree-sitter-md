+  unsigned char first = subj->input.data[*start], last = subj->input.data[*end - 1];
+  if ((first != ' ' && !S_is_line_end_char(first)) ||
+      (last != ' ' && !S_is_line_end_char(last)))
+    return;
+  bool has_data = false;
+  for (bufsize_t pos = *start; pos < *end; pos++) {
+    unsigned char c = subj->input.data[pos];
