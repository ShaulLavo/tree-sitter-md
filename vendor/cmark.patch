+static uint32_t cjk_category(int32_t scalar) {
+  size_t low = 0, high = sizeof(cjk_categories) / sizeof(*cjk_categories);
+  while (low < high) {
+    size_t mid = low + (high - low) / 2;
+    if ((uint32_t)scalar > cjk_categories[mid].end)
